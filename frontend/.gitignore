# ============================================
# SAITRONICS E-COMMERCE PLATFORM - .gitignore
# ============================================

# 1. Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 2. Next.js Build Outputs & Cache
/.next/
/out/
/build/
/dist/
.turbo/

# 3. Environment Variables & Credentials
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# 4. TypeScript & Linters
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# 5. OS & Filesystem Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. IDEs & Editor Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*.bak

# 7. Testing & Coverage
/coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# 8. Hosting & Cloud
.vercel/
.serverless/

# 9. Temporary & Log Files
*.log
*.tmp
*.temp
