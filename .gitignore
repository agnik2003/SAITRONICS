# 1. Documents & PDFs (Per user instruction: do not upload)
*.pdf
PROJECT SCOPE SAITRONICS.pdf
**/*.pdf

# 2. Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 3. Build Outputs & Caches
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/

# 4. Environment & Secrets
.env
.env*.local
.env.local
**/.env
**/.env*.local
**/.env.local
*.pem
*.key

# 5. TypeScript & Linters
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/.eslintcache
.stylelintcache

# 6. OS Junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# 7. IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.bak

# 8. Hosting & Cloud
.vercel/
**/.vercel/
